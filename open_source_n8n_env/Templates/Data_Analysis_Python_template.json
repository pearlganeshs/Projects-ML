    {
      "parameters": {
        "jsCode": "const raw=$json.stdout ?? ''; let parsed; try { parsed=JSON.parse(raw); } catch(e) { throw new Error('Python script must print a JSON array to stdout: '+String(raw).slice(0,250)); } if(!Array.isArray(parsed)) throw new Error('Expected JSON array from Python.'); return parsed.map(x=>({json:x}));"
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Parse Python Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        520
      ]
    },
    {
      "parameters": {
        "mode": "append",
        "numberInputs": 3,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Combine Oracle + Excel + Python",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        730,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Example harmonization: normalize field names and calculate revenue. Adapt mappings to your Oracle/Excel schema.\\nconst input=$input.all().map(x=>x.json); const seen=new Set(); const out=[]; for(const r of input){const x={...r}; const q=Number(x.quantity), p=Number(x.unit_price); if(Number.isFinite(q)&&Number.isFinite(p)&&x.revenue==null)x.revenue=q*p; const sig=JSON.stringify(x); if(!seen.has(sig)){seen.add(sig);out.push(x);}} const total=out.reduce((s,r)=>s+(Number(r.revenue)||0),0); const regions={}; for(const r of out){const k=r.region||'Unknown'; regions[k]=(regions[k]||0)+(Number(r.revenue)||0);} return out.map(r=>({json:{...r,_analysis:{recordCount:out.length,totalRevenue:total,revenueByRegion:regions}}}));"
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Clean + Analyze Dataset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        970,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Main output: each item appears as a table in n8n execution data.\\nreturn $input.all();"
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Table Output (n8n Execution)",
      "type": "n8n-nodes-base.code",
