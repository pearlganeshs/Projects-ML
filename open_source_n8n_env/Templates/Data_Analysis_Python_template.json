    {
      "parameters": {
        "jsCode": "// Builds a small standalone HTML dashboard from the analyzed items.\\nconst rows=$input.all().map(x=>x.json); const total=rows.reduce((s,r)=>s+(Number(r.revenue)||0),0); const by={}; for(const r of rows){const k=r.region||'Unknown';by[k]=(by[k]||0)+(Number(r.revenue)||0);} const max=Math.max(1,...Object.values(by)); const bars=Object.entries(by).map(([k,v])=>`<p>${k} \u2014 ${v.toLocaleString()}<div style=\\\"background:#e8eef7;height:12px;border-radius:8px\\\"><div style=\\\"width:${v/max*100}%;background:#2563eb;height:12px;border-radius:8px\\\"></div></div></p>`).join(''); const esc=s=>String(s??'').replace(/[&<>\\\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;'}[c])); const table=rows.slice(0,100).map(r=>`<tr><td>${esc(r.customer_name||r.customer_id||'')}</td><td>${esc(r.region)}</td><td>${esc(r.product)}</td><td>${esc(r.quantity)}</td><td>${(Number(r.revenue)||0).toLocaleString()}</td></tr>`).join(''); const html=`<!doctype html><html><meta charset=\\\"utf-8\\\"><title>n8n Analysis Dashboard</title><style>body{font:15px Arial;background:#f4f7fb;color:#172033;margin:30px}main{max-width:1000px;margin:auto}.card{background:white;padding:20px;border:1px solid #e2e8f0;border-radius:12px;margin:14px 0}.kpi{font-size:28px;font-weight:bold}table{width:100%;border-collapse:collapse}td,th{padding:9px;border-bottom:1px solid #e5eaf1;text-align:left}</style><main><h1>Data Analysis Dashboard</h1><div class=\\\"card\\\">Total records <b>${rows.length}</b><p>Total revenue</p><div class=\\\"kpi\\\">${total.toLocaleString()}</div></div><div class=\\\"card\\\"><h2>Revenue by Region</h2>${bars}</div><div class=\\\"card\\\"><h2>Data Preview</h2><table><tr><th>Customer</th><th>Region</th><th>Product</th><th>Quantity</th><th>Revenue</th></tr>${table}</table></div></main></html>`; const binary=await this.helpers.prepareBinaryData(Buffer.from(html,'utf8'),'analysis_dashboard.html','text/html'); return [{json:{fileName:'analysis_dashboard.html',recordCount:rows.length},binary:{data:binary}}];"
      },
